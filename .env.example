# Google Analytics 4 measurement ID.
# Copy this file to .env locally or set the value in your hosting provider.
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: turn off all analytics scripts.
PUBLIC_ANALYTICS_DISABLED=false

# Optional Plausible fallback. Leave unset when using Google Analytics.
# PUBLIC_PLAUSIBLE_DOMAIN=promax.dev
# PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.outbound-links.js

# Optional Giscus comments.
# Generate these at https://giscus.app after enabling GitHub Discussions.
# PUBLIC_GISCUS_REPO=sirdarthvader/blog
# PUBLIC_GISCUS_REPO_ID=R_kg...
# PUBLIC_GISCUS_CATEGORY=General
# PUBLIC_GISCUS_CATEGORY_ID=DIC_kw...
# PUBLIC_GISCUS_MAPPING=pathname
# PUBLIC_GISCUS_THEME=preferred_color_scheme
