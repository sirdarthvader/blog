---
interface Props {
  variant?: 'muted' | 'color';
  caption?: string;
}

const {
  variant = 'muted',
  caption = 'A small nod to Madhubani, Bihar, and the Mithila paintings I grew up around through my mother and aunt.',
} = Astro.props;
---

<figure class:list={['mithila-memory', `mithila-memory-${variant}`]}>
  <svg viewBox="0 0 420 560" role="img" aria-labelledby="mithila-title mithila-desc">
    <title id="mithila-title">Mithila-inspired memory from Bihar</title>
    <desc id="mithila-desc">
      A quiet line illustration inspired by Mithila painting traditions from Madhubani, Bihar.
    </desc>

    <rect class="frame" x="18" y="18" width="384" height="524" rx="2" />
    <rect class="inner-frame" x="30" y="30" width="360" height="500" rx="1" />

    <g class="border">
      {Array.from({ length: 16 }).map((_, index) => (
        <path d={`M${42 + index * 22} 38l8 12l8-12`} />
      ))}
      {Array.from({ length: 16 }).map((_, index) => (
        <path d={`M${42 + index * 22} 522l8-12l8 12`} />
      ))}
      {Array.from({ length: 23 }).map((_, index) => (
        <path d={`M38 ${58 + index * 20}l12 8l-12 8`} />
      ))}
      {Array.from({ length: 23 }).map((_, index) => (
        <path d={`M382 ${58 + index * 20}l-12 8l12 8`} />
      ))}
    </g>

    <g class="background-pattern">
      {Array.from({ length: 14 }).map((_, index) => (
        <path d={`M60 ${92 + index * 24}c18-16 35-16 52 0`} />
      ))}
      {Array.from({ length: 14 }).map((_, index) => (
        <path d={`M308 ${92 + index * 24}c18-16 35-16 52 0`} />
      ))}
      {Array.from({ length: 9 }).map((_, index) => (
        <path d={`M74 ${188 + index * 20}c18 8 32 8 50 0`} />
      ))}
      {Array.from({ length: 9 }).map((_, index) => (
        <path d={`M296 ${188 + index * 20}c18 8 32 8 50 0`} />
      ))}
      {Array.from({ length: 22 }).map((_, index) => (
        <circle cx={78 + (index % 11) * 24} cy={174 + Math.floor(index / 11) * 234} r="2.1" />
      ))}
      {Array.from({ length: 18 }).map((_, index) => (
        <circle cx={84 + (index % 9) * 31} cy={216 + Math.floor(index / 9) * 150} r="1.8" />
      ))}
    </g>

    <g class="sun">
      <circle cx="210" cy="122" r="38" />
      <circle cx="210" cy="122" r="26" />
      {Array.from({ length: 18 }).map((_, index) => {
        const angle = (index * Math.PI) / 9;
        const x1 = 210 + Math.cos(angle) * 49;
        const y1 = 122 + Math.sin(angle) * 49;
        const x2 = 210 + Math.cos(angle) * 67;
        const y2 = 122 + Math.sin(angle) * 67;
        return <path d={`M${x1.toFixed(1)} ${y1.toFixed(1)}L${x2.toFixed(1)} ${y2.toFixed(1)}`} />;
      })}
      <path d="M192 117c8-8 28-8 36 0" />
      <path d="M193 133c9 8 25 8 34 0" />
      {Array.from({ length: 10 }).map((_, index) => (
        <circle cx={182 + index * 6.2} cy="151" r="1.6" />
      ))}
    </g>

    <g class="vines">
      <path d="M74 436c30-78 32-166 7-244" />
      <path d="M346 436c-30-78-32-166-7-244" />
      {Array.from({ length: 10 }).map((_, index) => {
        const y = 207 + index * 22;
        return (
          <>
            <path d={`M78 ${y}c-18-9-28-20-33-35c19 3 31 13 38 30`} />
            <path d={`M342 ${y}c18-9 28-20 33-35c-19 3-31 13-38 30`} />
          </>
        );
      })}
      {Array.from({ length: 8 }).map((_, index) => {
        const y = 220 + index * 24;
        return (
          <>
            <path d={`M82 ${y}c20 7 32 18 38 34c-21-1-34-12-42-29`} />
            <path d={`M338 ${y}c-20 7-32 18-38 34c21-1 34-12 42-29`} />
          </>
        );
      })}
    </g>

    <g class="fish fish-left">
      <path d="M76 306c31-48 91-48 122 0c-31 48-91 48-122 0z" />
      <path d="M76 306l-42-31c10 25 10 37 0 62z" />
      <circle cx="176" cy="294" r="4.6" />
      <path d="M105 281c12 14 12 36 0 50" />
      <path d="M130 270c16 21 16 51 0 72" />
      <path d="M160 274c12 19 12 45 0 64" />
      <path d="M96 306h82" />
      <path d="M127 264c13-14 29-20 49-18c-9 17-23 27-44 30" />
      <path d="M127 348c13 14 29 20 49 18c-9-17-23-27-44-30" />
      {Array.from({ length: 4 }).map((_, row) =>
        Array.from({ length: 4 - row }).map((_, col) => (
          <path d={`M${101 + col * 17 + row * 9} ${290 + row * 12}c7-7 14-7 21 0c-7 7-14 7-21 0z`} />
        ))
      )}
      {Array.from({ length: 12 }).map((_, index) => (
        <circle cx={92 + index * 8} cy={320 + (index % 2) * 9} r="1.55" />
      ))}
    </g>

    <g class="fish fish-right">
      <path d="M344 306c-31-48-91-48-122 0c31 48 91 48 122 0z" />
      <path d="M344 306l42-31c-10 25-10 37 0 62z" />
      <circle cx="244" cy="294" r="4.6" />
      <path d="M315 281c-12 14-12 36 0 50" />
      <path d="M290 270c-16 21-16 51 0 72" />
      <path d="M260 274c-12 19-12 45 0 64" />
      <path d="M324 306h-82" />
      <path d="M293 264c-13-14-29-20-49-18c9 17 23 27 44 30" />
      <path d="M293 348c-13 14-29 20-49 18c9-17 23-27 44-30" />
      {Array.from({ length: 4 }).map((_, row) =>
        Array.from({ length: 4 - row }).map((_, col) => (
          <path d={`M${319 - col * 17 - row * 9} ${290 + row * 12}c-7-7-14-7-21 0c7 7 14 7 21 0z`} />
        ))
      )}
      {Array.from({ length: 12 }).map((_, index) => (
        <circle cx={328 - index * 8} cy={320 + (index % 2) * 9} r="1.55" />
      ))}
    </g>

    <g class="lotus">
      <path d="M210 404c-14-22-14-44 0-66c14 22 14 44 0 66z" />
      <path d="M181 410c-25-16-37-36-38-60c24 12 38 31 38 60z" />
      <path d="M239 410c25-16 37-36 38-60c-24 12-38 31-38 60z" />
      <path d="M160 416c32 14 68 14 100 0" />
      <path d="M210 404v62" />
      <path d="M166 450c22-7 66-7 88 0" />
      {Array.from({ length: 8 }).map((_, index) => (
        <path d={`M${176 + index * 10} 422c6 13 6 26 0 39`} />
      ))}
      {Array.from({ length: 5 }).map((_, index) => (
        <path d={`M${194 + index * 8} 360c6 10 6 21 0 31`} />
      ))}
      {Array.from({ length: 17 }).map((_, index) => (
        <circle cx={152 + index * 7} cy={436 + (index % 2) * 9} r="1.5" />
      ))}
      {Array.from({ length: 7 }).map((_, index) => (
        <path d={`M${147 + index * 20} 488c10-13 23-13 33 0`} />
      ))}
      <text x="150" y="502">Madhubani, Bihar</text>
    </g>

    <g class="ground">
      {Array.from({ length: 12 }).map((_, index) => (
        <path d={`M${56 + index * 26} 508c8-18 19-18 27 0`} />
      ))}
      {Array.from({ length: 12 }).map((_, index) => (
        <path d={`M${58 + index * 26} 508c7 9 7 18 0 27`} />
      ))}
    </g>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .mithila-memory {
    display: grid;
    gap: 0.48rem;
    justify-items: center;
    width: 100%;
    margin: 0;
    color: var(--illustration);
  }

  .mithila-memory svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .mithila-memory figcaption {
    width: min(13.5rem, 56%);
    color: var(--text-nav);
    font-size: 0.75625rem;
    line-height: 1.38;
    text-align: center;
  }

  .mithila-memory path,
  .mithila-memory circle,
  .mithila-memory rect {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.35;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .inner-frame {
    opacity: 0.42;
  }

  .mithila-memory text {
    fill: currentColor;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 12px;
    letter-spacing: 0;
  }

  .border,
  .background-pattern,
  .sun,
  .vines,
  .fish,
  .lotus,
  .ground {
    opacity: 0.78;
  }

  .background-pattern,
  .ground {
    opacity: 0.34;
  }

  .fish path,
  .fish circle {
    stroke-width: 1.7;
  }

  .mithila-memory-color {
    color: #d9d2bf;
  }

  .mithila-memory-color .frame,
  .mithila-memory-color .frame path,
  .mithila-memory-color .frame circle,
  .mithila-memory-color .frame rect {
    stroke: #d8c9a8;
  }

  .mithila-memory-color .inner-frame,
  .mithila-memory-color .inner-frame path,
  .mithila-memory-color .inner-frame circle,
  .mithila-memory-color .inner-frame rect {
    stroke: #6b83c4;
    opacity: 0.88;
  }

  .mithila-memory-color .border path,
  .mithila-memory-color .ground path,
  .mithila-memory-color .ground circle {
    stroke: #d8b34a;
    opacity: 0.9;
  }

  .mithila-memory-color .background-pattern path {
    stroke: #6b83c4;
    opacity: 0.42;
  }

  .mithila-memory-color .background-pattern circle {
    fill: #d85d66;
    stroke: #d85d66;
    opacity: 0.5;
  }

  .mithila-memory-color .sun path,
  .mithila-memory-color .sun circle {
    stroke: #e7b84d;
    opacity: 0.95;
  }

  .mithila-memory-color .sun circle:nth-of-type(2) {
    stroke: #d85d66;
  }

  .mithila-memory-color .vines path,
  .mithila-memory-color .vines circle {
    stroke: #69b36d;
    opacity: 0.9;
  }

  .mithila-memory-color .fish-left path,
  .mithila-memory-color .fish-left circle {
    stroke: #ef6a3f;
    opacity: 0.95;
  }

  .mithila-memory-color .fish-right path,
  .mithila-memory-color .fish-right circle {
    stroke: #e84f78;
    opacity: 0.95;
  }

  .mithila-memory-color .fish circle {
    fill: #f0bf3f;
    stroke: #f0bf3f;
  }

  .mithila-memory-color .lotus path,
  .mithila-memory-color .lotus circle {
    stroke: #cc5b8d;
    opacity: 0.94;
  }

  .mithila-memory-color .lotus circle {
    fill: #e7b84d;
    stroke: #e7b84d;
  }

  .mithila-memory-color text,
  .mithila-memory-color .lotus text {
    fill: #d8c9a8;
  }

  @media (max-width: 820px) {
    .mithila-memory figcaption {
      width: min(14.5rem, 64%);
    }
  }
</style>
