---
interface Props {
  tags: string[];
  linkable?: boolean;
}

const { tags, linkable = true } = Astro.props;
---

<ul class="tag-list">
  {tags.map((tag) => (
    <li>
      {linkable ? (
        <a
          href={`/tags/${encodeURIComponent(tag)}`}
          class="tag-pill"
        >
          #{tag}
        </a>
      ) : (
        <span class="tag-pill">
          #{tag}
        </span>
      )}
    </li>
  ))}
</ul>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .tag-pill {
    display: inline-flex;
    align-items: center;
    min-height: 1.55rem;
    padding: 0.16rem 0.45rem 0.2rem;
    border: 1px solid rgba(248, 220, 72, 0.38);
    border-radius: 999px;
    background: rgba(248, 220, 72, 0.14);
    color: #f8dc48;
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    line-height: 1;
    text-decoration: none;
  }

  a.tag-pill:hover {
    border-color: rgba(248, 220, 72, 0.68);
    background: rgba(248, 220, 72, 0.24);
    color: #ffe86d;
  }
</style>
