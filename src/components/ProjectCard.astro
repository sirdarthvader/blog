---
import TagList from './TagList.astro';

interface Props {
  title: string;
  description: string;
  slug: string;
  tags: string[];
  url?: string;
  github?: string;
}

const { title, description, slug, tags, url, github } = Astro.props;
---

<article style="padding: 0.75rem 0;">
  <a href={`/projects/${slug}`} style="text-decoration: none;">
    <h2 style="font-weight: 500; font-size: 1rem; margin-bottom: 0.25rem;" class="project-title">
      {title}
    </h2>
    <p style="font-size: 0.9375rem; color: var(--text-nav); line-height: 1.625; margin-bottom: 0.75rem;">{description}</p>
  </a>
  {tags.length > 0 && (
    <div style="margin-bottom: 0.75rem;">
      <TagList tags={tags} linkable />
    </div>
  )}
  <div style="display: flex; gap: 1rem;">
    {github && (
      <a href={github} target="_blank" rel="noopener noreferrer" style="font-family: ui-monospace, monospace; font-size: 0.75rem; color: var(--text-nav);">
        GitHub ↗
      </a>
    )}
    {url && (
      <a href={url} target="_blank" rel="noopener noreferrer" style="font-family: ui-monospace, monospace; font-size: 0.75rem; color: var(--text-nav);">
        Live ↗
      </a>
    )}
  </div>
</article>

<style>
  .project-title {
    color: var(--text-heading);
  }

  a:hover .project-title {
    color: var(--text-nav-hover);
  }
</style>
