---
import FormattedDate from './FormattedDate.astro';
import type { StoryGraph } from '../lib/contentGraph';

interface Props {
  story: StoryGraph;
}

const { story } = Astro.props;
---

<article class="story-card">
  <a href={story.href}>
    <div class="story-card__topline">
      <span>{story.chapterCount} {story.chapterCount === 1 ? 'chapter' : 'chapters'}</span>
      {story.updatedAt && (
        <time datetime={story.updatedAt.toISOString()}>
          Updated <FormattedDate date={story.updatedAt} />
        </time>
      )}
    </div>
    <h2>{story.title}</h2>
    <p>{story.description}</p>
  </a>
</article>

<style>
  .story-card a {
    display: block;
    text-decoration: none;
  }

  .story-card__topline {
    color: var(--text-nav);
    display: flex;
    flex-wrap: wrap;
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    gap: 0.75rem;
    justify-content: space-between;
    margin-bottom: 0.35rem;
  }

  .story-card h2 {
    color: var(--text-heading);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.5;
    margin-bottom: 0.25rem;
  }

  .story-card p {
    color: var(--text-nav);
    font-size: 0.9375rem;
    line-height: 1.625;
  }

  .story-card a:hover h2 {
    color: var(--text-nav-hover);
  }
</style>
