---
import BaseLayout from '../layouts/BaseLayout.astro';
import MithilaMemory from '../components/MithilaMemory.astro';
import { getCollection } from 'astro:content';
const isLocalhost = import.meta.env.DEV || import.meta.env.MODE === 'localhost';
const posts = (await getCollection('blog', ({ data }) => isLocalhost ? data : !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 8);

const notes = (await getCollection('notes', ({ data }) => isLocalhost ? data : !data.draft))
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title))
  .slice(0, 8);

const mediumArticles = [
  {
    title: 'An intro to Webpack: what it is and how to use it',
    href: 'https://medium.com/free-code-camp/an-intro-to-webpack-what-it-is-and-how-to-use-it-8304ecdc3c60',
    date: 'January 2019',
  },
  {
    title: 'How to deploy a React app with an Express server on Heroku',
    href: 'https://medium.com/free-code-camp/how-to-deploy-a-react-app-with-an-express-server-on-heroku-32244fe5a250',
    date: 'December 2018',
  },
  {
    title: 'Learn how to manipulate the DOM by building a simple JavaScript color game',
    href: 'https://medium.com/free-code-camp/learn-how-to-manipulate-the-dom-by-building-a-simple-javascript-color-game-1a3aec1d109a',
    date: 'June 2018',
  },
];
---

<BaseLayout
  title="Home"
  description="Ashish Nandan Singh builds frontend platforms, internal frameworks, and tiny learning projects to understand how software really works."
  wide
>
  <div class="home-grid">
    <div class="home-content">
      <h1>Ashish Nandan Singh</h1>

      <section class="section bio" aria-label="Biography">
        <p>
          I am an engineer, reader, and writer with a lifelong inability to
          leave interesting machinery alone. At
          <a href="https://www.cvent.com" target="_blank" rel="noopener noreferrer">Cvent</a>,
          I work on <mark>frontend platforms</mark>: internal development
          frameworks, developer foundations, and the runtime architecture behind
          independently built <mark>Next.js</mark> applications.
        </p>

        <p>
          Lately I have been deep in the mildly cursed, very interesting world
          of <mark>microfrontends</mark>: RSC payloads, runtime composition, Shadow DOM
          isolation, shared modules, protected proxying, and all the sharp edges
          that appear when framework theory meets product reality.
        </p>

        <p>
          I write to explain the parts of programming that only become clear
          once you build them yourself. In the long list of things I have poked
          at because curiosity won, <mark>Fluffy</mark>, a tiny React framework,
          is simply the current one. The <mark>Neovim</mark> problem, however,
          appears to be permanent.
        </p>
      </section>

      <section class="section" aria-labelledby="notes-heading">
        <h2 id="notes-heading">Notes</h2>
        <ul class="link-list notes-list">
          {notes.map((note) => (
            <li>
              <a href={`/notes/${note.id}`} onclick={`window.trackSiteEvent?.('homepage_note_click', { note: '${note.id}' })`}>
                {note.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="section" aria-labelledby="blogs-heading">
        <h2 id="blogs-heading">Blogs</h2>
        <div class="blog-list">
          {posts.map((post) => (
            <a
              class="blog-link"
              href={`/blog/${post.id}`}
              onclick={`window.trackSiteEvent?.('homepage_blog_click', { post: '${post.id}' })`}
            >
              <span>{post.data.title}</span>
              <time datetime={post.data.publishedAt.toISOString()}>
                {post.data.publishedAt.toLocaleDateString('en-US', {
                  month: 'long',
                  year: 'numeric',
                })}
              </time>
            </a>
          ))}
        </div>
      </section>

      <section class="section" aria-labelledby="medium-heading">
        <div class="section-heading-row">
          <h2 id="medium-heading">From Medium</h2>
          <a href="/notes/medium-archive">Full archive</a>
        </div>
        <div class="blog-list">
          {mediumArticles.map((article) => (
            <a
              class="blog-link"
              href={article.href}
              target="_blank"
              rel="noopener noreferrer"
              onclick={`window.trackSiteEvent?.('medium_archive_click', { article: '${article.title}' })`}
            >
              <span>{article.title}</span>
              <time>{article.date}</time>
            </a>
          ))}
        </div>
      </section>

      <section class="section small-links" aria-label="Elsewhere">
        <a href="/about">About</a>
        <a href="https://github.com/sirdarthvader" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="https://linkedin.com/in/ashish-nandan-singh" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </section>
    </div>

    <aside class="memory-panel" aria-label="Madhubani memory">
      <MithilaMemory variant="color" />
    </aside>
  </div>
</BaseLayout>

<style>
  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 40rem) minmax(24rem, 32rem);
    gap: clamp(3.5rem, 7vw, 6rem);
    align-items: start;
  }

  h1 {
    color: var(--text-heading);
    font-size: clamp(2.6rem, 6vw, 4.5rem);
    line-height: 1;
    font-weight: 500;
    margin-bottom: 2.25rem;
  }

  .section {
    margin-top: 3rem;
  }

  .bio {
    margin-top: 0;
  }

  .bio p {
    color: var(--text-copy);
    line-height: 1.75;
    margin-bottom: 1.25rem;
  }

  h2 {
    color: var(--text-heading);
    font-size: 1.25rem;
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .section-heading-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .section-heading-row h2 {
    margin-bottom: 0;
  }

  .section-heading-row a {
    color: var(--text-nav);
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  .link-list {
    list-style: square;
    padding-left: 1.1rem;
    columns: 2;
    column-gap: 2.5rem;
  }

  .link-list li {
    break-inside: avoid;
    margin-bottom: 0.55rem;
    padding-left: 0.25rem;
  }

  .blog-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .blog-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    color: var(--text-copy);
  }

  .blog-link time {
    color: var(--text-nav);
    white-space: nowrap;
  }

  .small-links {
    display: flex;
    gap: 1rem;
    font-size: 0.9375rem;
  }

  .memory-panel {
    position: sticky;
    top: 2rem;
    padding-top: 0.4rem;
  }

  @media (max-width: 820px) {
    .home-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .memory-panel {
      position: static;
      max-width: 28rem;
      margin: 0 auto;
    }
  }

  @media (max-width: 560px) {
    .link-list {
      columns: 1;
    }

    .blog-link {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
