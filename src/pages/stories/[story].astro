---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getAllStories, getStoryGraph } from '../../lib/contentGraph';

export async function getStaticPaths() {
  const showDrafts = import.meta.env.DEV || import.meta.env.MODE === 'localhost';
  const posts = await getCollection('blog', ({ data }) => showDrafts || !data.draft);

  return getAllStories(posts).map((story) => ({
    params: { story: story.id },
    props: { story },
  }));
}

const { story } = Astro.props;
const showDrafts = import.meta.env.DEV || import.meta.env.MODE === 'localhost';
const posts = await getCollection('blog', ({ data }) => showDrafts || !data.draft);
const graph = getStoryGraph(posts, story.id);
const hub = graph.posts.find((post) => post.role === 'hub');
const chapters = graph.posts.filter((post) => post.role === 'chapter');
const visibleLinks = graph.links.filter((link) => link.type !== 'parent');
const siteUrl = Astro.site ?? 'https://promax.dev';
const storyUrl = new URL(graph.href, siteUrl).toString();
const storySeoTitle = graph.id === 'graphs'
  ? 'Learn Graphs for Programming from First Principles'
  : `${graph.title}: Learn from First Principles`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: graph.title,
    description: graph.description,
    url: storyUrl,
    mainEntity: {
      '@type': 'ItemList',
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      itemListElement: graph.posts.map((post, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: post.title,
        description: post.description,
        url: new URL(post.href, siteUrl).toString(),
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Stories',
        item: new URL('/stories', siteUrl).toString(),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: graph.title,
        item: storyUrl,
      },
    ],
  },
];

function relationLabel(type: 'parent' | 'depends-on' | 'related') {
  if (type === 'depends-on') return 'builds on';
  if (type === 'related') return 'relates to';
  return 'belongs to';
}
---

<BaseLayout
  title={`${graph.title} Story`}
  seoTitle={storySeoTitle}
  description={graph.description}
  structuredData={structuredData}
>
  <div class="back-links">
    <a href="/stories">← Stories</a>
    <a href="/blog">Writing</a>
  </div>

  <header class="story-hero">
    <p>story</p>
    <h1>{graph.title}</h1>
    <span>{graph.description}</span>
  </header>

  {hub && (
    <section class="story-section" aria-labelledby="story-hub">
      <h2 id="story-hub">Hub</h2>
      <a class="story-card" href={hub.href}>
        <span>{hub.title}</span>
        <p>{hub.description}</p>
      </a>
    </section>
  )}

  {chapters.length > 0 && (
    <section class="story-section" aria-labelledby="story-chapters">
      <h2 id="story-chapters">Reading Path</h2>
      <ol class="story-list">
        {chapters.map((post) => (
          <li>
            <a href={post.href}>
              <span>{post.order}</span>
              <strong>{post.title}</strong>
              <p>{post.description}</p>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )}

  {visibleLinks.length > 0 && (
    <section class="story-section" aria-labelledby="story-links">
      <h2 id="story-links">Connections</h2>
      <p class="story-section-note">
        These show why the reading path is ordered this way.
      </p>
      <ul class="story-links">
        {visibleLinks.map((link) => {
          const source = graph.posts.find((post) => post.id === link.source);
          const target = graph.posts.find((post) => post.id === link.target);
          if (!source || !target) return null;

          return (
            <li>
              <a href={link.type === 'depends-on' ? target.href : source.href}>
                {link.type === 'depends-on' ? target.title : source.title}
              </a>
              <span>{relationLabel(link.type)}</span>
              <a href={link.type === 'depends-on' ? source.href : target.href}>
                {link.type === 'depends-on' ? source.title : target.title}
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  .back-links {
    align-items: baseline;
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .back-links a {
    color: var(--text-nav);
    font-family: ui-monospace, monospace;
    font-size: 0.875rem;
    text-decoration: none;
  }

  .back-links a + a {
    font-size: 0.75rem;
  }

  .back-links a:hover {
    color: var(--text-heading);
  }

  .story-hero {
    margin-bottom: 2rem;
  }

  .story-hero p {
    color: var(--text-nav);
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .story-hero h1 {
    color: var(--text-heading);
    font-size: 1.5rem;
    font-weight: 500;
    margin-bottom: 0.75rem;
  }

  .story-hero span {
    color: var(--text-nav);
    display: block;
    font-size: 1rem;
    line-height: 1.7;
  }

  .story-section {
    border-top: 1px solid var(--border);
    padding: 1.25rem 0 1.75rem;
  }

  .story-section h2 {
    color: var(--text-heading);
    font-size: 1rem;
    font-weight: 500;
    margin-bottom: 0.65rem;
  }

  .story-section-note {
    color: var(--text-nav);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: 0.85rem;
  }

  .story-card,
  .story-list a {
    text-decoration: none;
  }

  .story-card {
    display: block;
  }

  .story-card span,
  .story-list strong {
    color: var(--text-heading);
    font-size: 1rem;
    font-weight: 500;
  }

  .story-card p,
  .story-list p {
    color: var(--text-nav);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-top: 0.2rem;
  }

  .story-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .story-list a {
    display: grid;
    gap: 0.25rem 1rem;
    grid-template-columns: 2rem minmax(0, 1fr);
  }

  .story-list span {
    color: var(--text-nav);
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    padding-top: 0.25rem;
  }

  .story-list p {
    grid-column: 2;
    margin-bottom: 0;
  }

  .story-links {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .story-links li {
    color: var(--text-nav);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.875rem;
    gap: 0.5rem;
  }

  .story-links a {
    color: var(--text-heading);
    text-decoration: underline;
    text-decoration-color: #555;
  }

  .story-links span {
    color: rgba(248, 220, 72, 0.9);
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
  }
</style>
