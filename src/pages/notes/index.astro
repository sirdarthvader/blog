---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeBackLink from '../../components/HomeBackLink.astro';
import { getCollection } from 'astro:content';

const showDrafts = import.meta.env.DEV || import.meta.env.MODE === 'localhost';
const notes = (await getCollection('notes', ({ data }) => showDrafts || !data.draft))
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
---

<BaseLayout title="Notes" description="Evergreen notes, working principles, and maps of ideas.">
  <HomeBackLink />
  <header style="margin-bottom: 2.5rem;">
    <h1 style="font-size: 1.25rem; font-weight: 500; margin-bottom: 0.5rem; color: var(--text-heading);">Notes</h1>
    <p style="color: var(--text-nav); font-size: 0.9375rem;">
      Evergreen maps, working principles, and ideas I expect to keep revisiting.
    </p>
  </header>

  <div style="display: flex; flex-direction: column; gap: 0;">
    {notes.map((note) => (
      <article style="padding: 1.15rem 0; border-bottom: 1px solid var(--border);">
        <a href={`/notes/${note.id}`} style="text-decoration: none;">
          <h2 style="font-weight: 500; font-size: 1rem; line-height: 1.5; color: var(--text-heading);" class="note-title">
            {note.data.title}
          </h2>
          <p style="font-size: 0.9375rem; color: var(--text-nav); line-height: 1.625; margin-top: 0.25rem;">
            {note.data.description}
          </p>
        </a>
      </article>
    ))}
  </div>
</BaseLayout>

<style>
  a:hover .note-title {
    color: var(--text-nav-hover);
  }
</style>
