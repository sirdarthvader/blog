---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const showDrafts = import.meta.env.DEV || import.meta.env.MODE === 'localhost';
const projects = (await getCollection('projects', ({ data }) => showDrafts || !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const allTags = [...new Set(projects.flatMap((p) => p.data.tags))].sort();
const selectedTag = Astro.url.searchParams.get('tag');
const filtered = selectedTag
  ? projects.filter((p) => p.data.tags.includes(selectedTag))
  : projects;
---

<BaseLayout title="Projects" description="Things I've built." noindex={Boolean(selectedTag)}>
  <header style="margin-bottom: 2.5rem;">
    <h1 style="font-size: 1.25rem; font-weight: 500; margin-bottom: 0.5rem; color: var(--text-heading);">Projects</h1>
    <p style="color: var(--text-nav); font-size: 0.9375rem;">
      {projects.length} {projects.length === 1 ? 'project' : 'projects'} — things I've built and shipped.
    </p>
  </header>

  {allTags.length > 0 && (
    <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2rem;">
      <a
        href="/projects"
        style={`font-family: ui-monospace, monospace; font-size: 0.75rem; text-decoration: none; color: ${!selectedTag ? '#f8dc48' : 'var(--text-nav)'};`}
      >
        all
      </a>
      {allTags.map((tag) => (
        <a
          href={`/tags/${encodeURIComponent(tag)}`}
          style={`font-family: ui-monospace, monospace; font-size: 0.75rem; text-decoration: none; color: ${selectedTag === tag ? '#f8dc48' : 'var(--text-nav)'};`}
        >
          #{tag}
        </a>
      ))}
    </div>
  )}

  {filtered.length > 0 ? (
    <div style="display: flex; flex-direction: column;">
      {filtered.map((project) => (
        <div class="project-item">
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            slug={project.id}
            tags={project.data.tags}
            url={project.data.url}
            github={project.data.github}
          />
        </div>
      ))}
    </div>
  ) : (
    <p style="color: var(--text-nav);">No projects found{selectedTag ? ` for #${selectedTag}` : ''}.</p>
  )}
</BaseLayout>

<style>
  .project-item {
    border-bottom: 1px solid var(--border);
  }
</style>
