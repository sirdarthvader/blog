---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TagList from '../components/TagList.astro';
import GiscusComments from '../components/GiscusComments.astro';
import StoryNav from '../components/StoryNav.astro';
import type { StoryNavigation } from '../lib/contentGraph';

interface Props {
  title: string;
  seoTitle?: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  tags: string[];
  storyNavigation?: StoryNavigation;
}

const { title, seoTitle, description, publishedAt, updatedAt, tags, storyNavigation } = Astro.props;
const siteUrl = Astro.site ?? 'https://promax.dev';
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();
const storyUrl = storyNavigation
  ? new URL(storyNavigation.story.href, siteUrl).toString()
  : undefined;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: seoTitle ?? title,
    name: title,
    description,
    url: pageUrl,
    datePublished: publishedAt.toISOString(),
    ...(updatedAt ? { dateModified: updatedAt.toISOString() } : {}),
    keywords: tags,
    author: {
      '@type': 'Person',
      name: 'Ashish Nandan Singh',
      url: siteUrl.toString(),
    },
    publisher: {
      '@type': 'Person',
      name: 'Ashish Nandan Singh',
      url: siteUrl.toString(),
    },
    ...(storyNavigation ? {
      isPartOf: {
        '@type': 'CollectionPage',
        name: storyNavigation.story.title,
        url: storyUrl,
      },
      position: storyNavigation.current.role === 'hub' ? 0 : storyNavigation.current.order,
    } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Writing',
        item: new URL('/blog', siteUrl).toString(),
      },
      ...(storyNavigation ? [{
        '@type': 'ListItem',
        position: 2,
        name: storyNavigation.story.title,
        item: storyUrl,
      }] : []),
      {
        '@type': 'ListItem',
        position: storyNavigation ? 3 : 2,
        name: title,
        item: pageUrl,
      },
    ],
  },
];
---

<BaseLayout
  title={title}
  seoTitle={seoTitle}
  description={description}
  article
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  tags={tags}
  structuredData={structuredData}
>
  <article>
    <header style="margin-bottom: 2.5rem;">
      <div class="back-links">
        {storyNavigation ? (
          <a href={storyNavigation.story.href} class="back-link">← {storyNavigation.story.title}</a>
        ) : (
          <a href="/blog" class="back-link">← Writing</a>
        )}
        {storyNavigation && <a href="/blog" class="back-link back-link--secondary">Writing</a>}
      </div>
      <div style="font-family: ui-monospace, monospace; font-size: 0.875rem; color: var(--text-nav); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
        <FormattedDate date={publishedAt} />
        {updatedAt && (
          <>
            <span>·</span>
            <span>Updated <FormattedDate date={updatedAt} /></span>
          </>
        )}
      </div>
      <h1 style="font-size: 1.5rem; font-weight: 500; letter-spacing: -0.015em; margin-bottom: 1rem; color: var(--text-heading);">
        {title}
      </h1>
      <p style="color: var(--text-nav); font-size: 1.0625rem; line-height: 1.75;">{description}</p>
      {tags.length > 0 && (
        <div style="margin-top: 1rem;">
          <TagList tags={tags} linkable />
        </div>
      )}
    </header>

    {storyNavigation && <StoryNav navigation={storyNavigation} />}

    <div class="prose">
      <slot />
    </div>

    <footer style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--border);">
      <GiscusComments />
    </footer>
  </article>
</BaseLayout>

<style>
  .back-links {
    align-items: baseline;
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .back-link {
    display: inline-flex;
    color: var(--text-nav);
    font-family: ui-monospace, monospace;
    font-size: 0.875rem;
    text-decoration: none;
  }

  .back-link--secondary {
    font-size: 0.75rem;
  }

  .back-link:hover {
    color: var(--text-heading);
  }
</style>
