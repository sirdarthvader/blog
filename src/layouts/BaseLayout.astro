---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import SiteMark from '../components/SiteMark.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  article?: boolean;
  publishedAt?: Date;
  wide?: boolean;
}

const {
  title,
  description = 'Developer, writer, builder.',
  ogImage,
  article = false,
  publishedAt,
  wide = false,
} = Astro.props;

const siteUrl = Astro.site ?? 'https://promax.dev';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = ogImage ? new URL(ogImage, siteUrl) : new URL('/og-default.png', siteUrl);

const fullTitle = title === 'Home' ? 'Ashish Nandan Singh' : `${title} — Ashish Nandan Singh`;
const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    {article && publishedAt && (
      <meta property="article:published_time" content={publishedAt.toISOString()} />
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Ashish Nandan Singh — Blog" href="/rss.xml" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Analytics />
  </head>
  <body>
    <main class:list={['site-shell', wide && 'site-shell-wide']}>
      {!isHome && (
        <nav class="site-nav" aria-label="Primary navigation">
          <a class="site-mark" href="/" aria-label="Ashish Nandan Singh home">
            <SiteMark />
          </a>
        </nav>
      )}
      <slot />
    </main>
  </body>
</html>
