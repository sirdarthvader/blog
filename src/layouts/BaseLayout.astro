---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import SiteMark from '../components/SiteMark.astro';

interface Props {
  title: string;
  seoTitle?: string;
  description?: string;
  ogImage?: string;
  article?: boolean;
  publishedAt?: Date;
  updatedAt?: Date;
  tags?: string[];
  noindex?: boolean;
  wide?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  seoTitle,
  description = 'Developer, writer, builder.',
  ogImage,
  article = false,
  publishedAt,
  updatedAt,
  tags = [],
  noindex = false,
  wide = false,
  structuredData: extraStructuredData,
} = Astro.props;

const siteUrl = Astro.site ?? 'https://promax.dev';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = ogImage ? new URL(ogImage, siteUrl) : new URL('/og-default.png', siteUrl);

const pageTitle = seoTitle ?? title;
const fullTitle = pageTitle === 'Home' ? 'Ashish Nandan Singh' : `${pageTitle} — Ashish Nandan Singh`;
const isHome = Astro.url.pathname === '/';
const personId = new URL('/#person', siteUrl).href;
const websiteId = new URL('/#website', siteUrl).href;
const webPageId = `${canonicalURL.href}#webpage`;
const extraStructuredDataItems = Array.isArray(extraStructuredData)
  ? extraStructuredData
  : extraStructuredData
    ? [extraStructuredData]
    : [];

const baseStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: 'Ashish Nandan Singh',
      url: new URL('/', siteUrl).href,
      jobTitle: 'Frontend Platform Engineer',
      sameAs: [
        'https://github.com/sirdarthvader',
        'https://linkedin.com/in/ashish-nandan-singh',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: new URL('/', siteUrl).href,
      name: 'Ashish Nandan Singh',
      description: 'Writing on frontend platform engineering, software systems, and learning by building.',
      inLanguage: 'en',
      author: { '@id': personId },
    },
    {
      '@type': 'WebPage',
      '@id': webPageId,
      url: canonicalURL.href,
      name: fullTitle,
      description,
      isPartOf: { '@id': websiteId },
      about: { '@id': personId },
      inLanguage: 'en',
    },
    ...(article && publishedAt && extraStructuredDataItems.length === 0
      ? [
          {
            '@type': 'BlogPosting',
            '@id': `${canonicalURL.href}#article`,
            mainEntityOfPage: { '@id': webPageId },
            headline: title,
            description,
            datePublished: publishedAt.toISOString(),
            dateModified: (updatedAt ?? publishedAt).toISOString(),
            author: { '@id': personId },
            publisher: { '@id': personId },
            keywords: tags,
            inLanguage: 'en',
          },
        ]
      : []),
  ],
};
const structuredDataItems = [baseStructuredData, ...extraStructuredDataItems];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ashish Nandan Singh" />
    <meta name="theme-color" content="#1a1a1a" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Ashish Nandan Singh" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    {article && publishedAt && (
      <meta property="article:published_time" content={publishedAt.toISOString()} />
    )}
    {article && updatedAt && (
      <meta property="article:modified_time" content={updatedAt.toISOString()} />
    )}
    {article && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Ashish Nandan Singh — Blog" href="/rss.xml" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {structuredDataItems.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
    <Analytics />
  </head>
  <body>
    <main class:list={['site-shell', wide && 'site-shell-wide']}>
      {!isHome && (
        <nav class="site-nav" aria-label="Primary navigation">
          <a class="site-mark" href="/" aria-label="Ashish Nandan Singh home">
            <SiteMark />
          </a>
        </nav>
      )}
      <slot />
    </main>
  </body>
</html>
